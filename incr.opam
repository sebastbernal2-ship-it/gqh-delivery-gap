opam-version: "2.0"
version: "0.2.0"
synopsis:
  "A minimal incremental computation engine (DAG-based, wave propagation)"
description:
  "A self-contained incremental computation library inspired by Jane Street's Incremental library. Nodes form a DAG; when an input Var changes, only affected downstream nodes recompute in topological order via wave-based stabilization. Supports map, map2, map3, bind, cutoff, if_, and on_change. No external dependencies beyond the OCaml stdlib."
maintainer: ["sebastbernal2-ship-it"]
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.24"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
