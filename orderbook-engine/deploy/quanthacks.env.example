# Copy to ~/.config/quanthacks/env on the machine, fill in values, chmod 600.
# The setup script reads this file. Never commit the filled copy.
TIGERDATA_URL=
TIGERDATA_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=QUANTHACKS_AGENT
SNOWFLAKE_ROLE=GQH_MARKETDATA_RO
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_PRIVATE_KEY_PATH=/home/linuxuser/.config/quanthacks/snowflake/rsa_key.p8
MASSIVE_API_KEY=
GQH_MASSIVE_TEAM_STRATEGY_LICENSE=
