# Credentials never ship
.env
.env.*
*.pem
*.key

# Data is fetched or produced, never committed
data/*
!data/README.md

# Environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.ruff_cache/
.mypy_cache/

# Local artifacts and run output
*.parquet
*.db
*.duckdb
*.zip
*.log
*.out
*.err
*.npz
*.npy
*.h5
*.hdf5
*.pt
*.ckpt
*.safetensors
runs/
outputs/
wandb/
.DS_Store

# Local agent state
.hippo/
.pi/

# Memory: the team's shared files are committed, private device exports are not.
memory/*.json
!memory/shared.json
memory/*.md
!memory/SHARED.md

# Scratch directories for testing the new-device path
_devtest/
_clonetest/

# Local EDGAR cache: a local convenience, never committed.
results/edgar-cache/

# Local EIA vintage cache: public data, kept out of the repo.
results/eia-cache/

# Local price cache: fetched, never committed.
results/bar-cache/
